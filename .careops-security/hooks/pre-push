#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
command -v gitleaks >/dev/null 2>&1 || { echo 'Gitleaks is required.' >&2; exit 1; }
[ "$(git rev-parse --is-shallow-repository)" = false ] || { echo 'Fetch complete history before the pre-push audit.' >&2; exit 1; }
repo_python=${REPO_PYTHON:-.venv-careops-privacy/bin/python}
[ -x "$repo_python" ] || { echo 'Create the repository-local privacy environment.' >&2; exit 1; }
zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$local_oid" = "$zero" ] && continue
    for oid in "$local_oid" "$remote_oid"; do
        case "$oid" in ''|*[!0-9a-f]*) echo 'Invalid outgoing object ID.' >&2; exit 1;; esac
        [ "${#oid}" = 40 ] || { echo 'Expected a full outgoing object ID.' >&2; exit 1; }
    done
    if [ "$remote_oid" = "$zero" ]; then
        gitleaks git . --log-opts="$local_oid" --gitleaks-ignore-path /dev/null --ignore-gitleaks-allow --redact --no-banner
        "$repo_python" -I .careops-security/check.py --revision "$local_oid" --history
    else
        gitleaks git . --log-opts="$remote_oid..$local_oid" --gitleaks-ignore-path /dev/null --ignore-gitleaks-allow --redact --no-banner
        "$repo_python" -I .careops-security/check.py --revision "$local_oid" --base "$remote_oid"
    fi
done
