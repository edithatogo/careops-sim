cff-version: 1.2.0
message: "If you use CareOps Sim in research, healthcare operational analyses, or software studies, please cite the project using this metadata."
title: "CareOps Sim: A Rust-Native Emergency Department Discrete-Event Simulation and Agent-Based Modeling System"
version: "0.1.0"
date-released: "2026-10-16"
type: software
authors:
  - family-names: "Mordaunt"
    given-names: "Dylan A."
  - name: "CareOps Sim Contributors"
abstract: "CareOps Sim is a Rust-native emergency department discrete-event simulation (DES) and agent-based modeling (ABM) engine built on KairoECS, featuring priority preemption with work conservation, clinical pathway state machines, dual macro/micro spatial execution fidelities, and Arrow telemetry export."
keywords:
  - "emergency-department"
  - "healthcare-operations"
  - "discrete-event-simulation"
  - "agent-based-modeling"
  - "rust"
  - "apache-arrow"
license: "Apache-2.0"
repository-code: "https://github.com/edithatogo/careops-sim"
