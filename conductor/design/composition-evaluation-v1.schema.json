    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "careops.composition.evaluation.v1"
    },
    "provenance": {
      "type": "object",
      "required": [
        "class",
        "empirical_data_used",
        "fitting_performed",
        "parameter_promotion",
        "clinical_acceptance"
      ],
      "properties": {
        "class": {
          "const": "synthetic_only"
        },
        "empirical_data_used": {
          "const": false
        },
        "fitting_performed": {
          "const": false
        },
        "parameter_promotion": {
          "const": false
        },
        "clinical_acceptance": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
