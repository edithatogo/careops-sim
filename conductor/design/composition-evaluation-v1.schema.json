            "locked_test": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
