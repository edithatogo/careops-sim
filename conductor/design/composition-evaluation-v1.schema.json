        "version",
        "rule_version",
        "decision_period",
        "effective_period",
        "lag_months",
        "capacity_unit",
        "evidence_window",
        "evidence_time_unit",
        "currency",
        "price_year",
        "activation",
        "monthly_extrapolation",
        "combines_cost_and_funding"
