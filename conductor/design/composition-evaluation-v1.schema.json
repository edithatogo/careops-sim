            "properties": {
              "feature_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "member_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "prediction_cutoff": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
