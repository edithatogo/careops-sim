                "type": "object",
                "required": [
                  "walk",
                  "work"
                ],
                "properties": {
                  "walk": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "work": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            },
            "selected_decomposition": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "walk",
                    "work"
                  ],
                  "properties": {
                    "walk": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "work": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "micro_hazards_identified": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "cluster_status": {
          "const": "identified_synthetic"
        }
      },
      "additionalProperties": false
