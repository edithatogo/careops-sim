              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "person_key": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "family_key": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "identifiability": {
          "type": "object",
          "required": [
            "scope",
            "observed_total",
            "candidate_decompositions",
            "selected_decomposition",
