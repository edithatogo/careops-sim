            "type": "object",
            "required": [
              "id",
              "domain",
              "risk_start",
              "event_tick",
              "available_at",
              "last_observed",
              "excluded_reason",
              "endpoint_status",
              "event_free_until",
              "event_free_available_at",
              "censor_reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "domain": {
                "enum": [
                  "ed",
                  "birthing"
