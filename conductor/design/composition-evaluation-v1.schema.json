        "decision_period": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "effective_period": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "lag_months": {
          "type": "integer",
          "minimum": 1
        },
        "capacity_unit": {
