        "window": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "time_unit": {
          "const": "second"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "price_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 9999
        },
        "perspective": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "aggregation_scope": {
          "const": "observed_window_only"
        },
        "ledger_units": {
          "type": "object",
          "required": [
            "activity",
            "resource",
            "cost",
            "funding",
            "outcome",
            "equity"
