            "type": "object",
            "required": [
              "id",
              "ledger",
              "source_event",
              "component",
              "basis",
              "quantity",
              "unit",
              "window",
              "currency",
              "price_year",
              "denominator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "ledger": {
                "enum": [
                  "activity",
                  "resource",
                  "cost",
                  "funding",
                  "outcome",
                  "equity"
                ]
              },
              "source_event": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "component": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "basis": {
                "enum": [
                  "clinical_activity",
                  "resource_use",
                  "payment",
                  "clinical_outcome",
                  "access"
                ]
              },
              "quantity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "window": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "currency": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "price_year": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "denominator": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
