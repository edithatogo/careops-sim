                ]
              },
              "excluded_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endpoint_status": {
                "enum": [
                  "observed",
                  "delayed",
                  "right_censored",
                  "missing",
                  "excluded",
                  "unknown"
