                ]
              },
              "event_free_available_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "censor_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "origin",
              "available_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "origin": {
                "enum": [
                  "observed",
                  "derived",
                  "latent"
                ]
              },
              "available_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
