{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careops:composition:evaluation:v1",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "provenance",
    "extends",
    "observation",
    "validation",
    "accounting",
    "fiscal_exchange"
