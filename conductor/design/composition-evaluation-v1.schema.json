              },
              "risk_start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "event_tick": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "available_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "last_observed": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
