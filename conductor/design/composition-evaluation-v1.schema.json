        "currency": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "price_year": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "activation": {
          "const": "proposal_only"
        },
        "monthly_extrapolation": {
          "const": false
        },
        "combines_cost_and_funding": {
