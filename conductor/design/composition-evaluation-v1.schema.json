          "const": "second"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "cohort_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "window": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
