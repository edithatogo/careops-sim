          "properties": {
            "activity": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "resource": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "cost": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "funding": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "outcome": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "equity": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
