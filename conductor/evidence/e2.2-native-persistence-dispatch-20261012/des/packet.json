  "test_oracles": [
    {
      "name": "v4_admission_order_roundtrip_and_legacy_versions",
      "proof": "Capture and restore admission-only V4 exactly; compare continuation and independently retain V1/V2/V3 behavior."
    },
    {
      "name": "v4_stable_pending_queued_roundtrip_preserves_effective_order",
      "proof": "Live StableKey resource with retained Pending and Queued requests roundtrips exact key bytes and same next effective grant."
    },
    {
      "name": "v4_active_suspended_resume_preserves_key_and_enqueue_sequence",
      "proof": "Active and Suspended requests retain immutable keys and original enqueue sequence through restore, reprioritize/Resume and continuation."
    },
    {
      "name": "v4_removed_resource_terminal_keys_roundtrip",
      "proof": "Removed resource with multiple retained terminal requests roundtrips uniform mode/key tags and request accessors; mutate one group row to prove disagreement rejection."
    },
    {
      "name": "v4_mixed_modes_have_canonical_complete_rows",
      "proof": "Mixed live AdmissionOrder and StableKey resources have strictly sorted one-row-per-live-resource modes and one-row-per-retained-request tags, including terminal identities."
    },
    {
      "name": "v4_malformed_metadata_rejects_before_codecs",
      "proof": "Wrong version; mode/request noncanonical, duplicate, missing and unknown rows; zero/129-byte key; live tag mismatch; removed-generation disagreement; invalid nonterminal missing-resource reference. Each structural mutation rejects before caller codecs; valid baseline invokes codecs."
    },
    {
      "name": "v4_capture_corrupt_sidecar_fails_before_codec_without_mutation",
      "proof": "Private corruption of source effective sidecar causes capture rejection before codecs with whole relevant runtime state unchanged; valid capture has positive codec control."
    },
    {
      "name": "v4_key_row_and_checked_total_limits_preflight_before_decode",
      "proof": "Exact 128-byte key and shared aggregate max_key_bytes boundary succeed; one-over and row-count limits reject before codec; test checked-add overflow helper directly; preserve max_payload_bytes semantics."
    },
    {
      "name": "v4_checked_key_byte_sum_rejects_overflow",
      "proof": "A private pure checked-add helper rejects aggregate opaque key-byte overflow without allocating or invoking codecs."
    },
    {
      "name": "v4_admission_default_rebuild_preserves_existing_payload",
      "proof": "Existing admission-only payload rebuilds all default modes/indexes and preserves queue, preempting and deadline membership."
    }
  ],
