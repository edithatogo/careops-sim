{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careops-sim.invalid/schemas/source-verification-record.schema.json",
  "title": "ED source verification record",
  "description": "A typed source claim, explicit synthetic assumption, or unresolved evidence gap. Report lineage is independent of primary-source provenance.",
  "oneOf": [
    { "$ref": "#/$defs/primary" },
    { "$ref": "#/$defs/assumption" },
    { "$ref": "#/$defs/gap" }
  ],
  "$defs": {
    "reportLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_sha256", "section", "line_start", "line_count"],
      "properties": {
        "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "section": { "type": "string", "minLength": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_count": { "type": "integer", "minimum": 1 }
      }
    },
    "optionalReportLineage": {
      "oneOf": [
        { "$ref": "#/$defs/reportLineage" },
        { "type": "null" }
      ]
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_id", "evidence_type", "parameter_ids", "claim", "primary_source", "report_lineage", "review", "independent_readback"],
      "properties": {
        "schema_version": { "const": 2 },
        "record_id": { "type": "string", "minLength": 1 },
        "evidence_type": { "const": "primary_source_claim" },
        "parameter_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^ed\\." } },
        "claim": { "type": "string", "minLength": 1 },
        "primary_source": { "$ref": "#/$defs/source" },
        "report_lineage": { "$ref": "#/$defs/reportLineage" },
        "review": { "$ref": "#/$defs/review" },
        "independent_readback": { "$ref": "#/$defs/independentReadback" }
      }
    },
    "independentReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "outcome", "reason", "readback_reference", "source_hash_recomputation", "locator_evidence", "transformation_evidence"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date" },
        "outcome": { "enum": ["pass", "partial", "contradiction", "unresolved"] },
        "reason": { "type": "string", "minLength": 1 },
        "readback_reference": { "type": "string", "minLength": 1 },
        "source_hash_recomputation": {
          "type": "object", "additionalProperties": false,
          "required": ["retrieved_bytes_sha256", "matches_recorded_hash"],
          "properties": {
            "retrieved_bytes_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "matches_recorded_hash": { "type": "boolean" }
          }
        },
        "locator_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["located", "locator_checked", "evidence_reference"],
          "properties": {
            "located": { "type": "boolean" },
            "locator_checked": { "type": "string", "minLength": 1 },
            "evidence_reference": { "type": "string", "minLength": 1 }
          }
        },
        "transformation_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["reproduced", "method", "comparison"],
          "properties": {
            "reproduced": { "type": "boolean" },
            "method": { "type": "string", "minLength": 1 },
            "comparison": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "outcome": { "const": "pass" } }, "required": ["outcome"] }, "then": {
          "properties": {
            "source_hash_recomputation": { "properties": { "matches_recorded_hash": { "const": true } } },
            "locator_evidence": { "properties": { "located": { "const": true } } },
            "transformation_evidence": { "properties": { "reproduced": { "const": true } } }
          }
        } }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "location", "source_sha256", "population", "period", "units", "licence_access", "accessed_at", "transformation", "verification"],
      "properties": {
        "url": { "type": "string", "format": "uri", "minLength": 1 },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
        "source_kind": { "enum": ["publication", "repository_code"] },
        "revision": { "type": "string", "minLength": 1 },
        "location": { "oneOf": [{ "$ref": "#/$defs/publicationLocation" }, { "$ref": "#/$defs/codeLocation" }] },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "population": { "type": "string", "minLength": 1 },
        "period": { "type": "string", "minLength": 1 },
        "units": { "type": "string", "minLength": 1 },
        "licence_access": { "type": "string", "minLength": 1 },
        "accessed_at": { "type": "string", "format": "date" },
        "transformation": { "type": "object", "additionalProperties": false, "required": ["description", "input_units", "output_units"], "properties": {
          "description": { "type": "string", "minLength": 1 },
          "input_units": { "type": "string", "minLength": 1 },
          "output_units": { "type": "string", "minLength": 1 }
        } },
        "verification": { "enum": ["verified", "partially_verified", "unverified", "contradicted"] }
      },
      "allOf": [
        { "if": { "properties": { "source_kind": { "const": "publication" } }, "required": ["source_kind"] }, "then": { "required": ["revision"], "anyOf": [{ "required": ["url"] }, { "required": ["doi"] }], "properties": { "location": { "properties": { "kind": { "const": "publication" } }, "required": ["kind"] } } } },
        { "if": { "properties": { "source_kind": { "const": "repository_code" } }, "required": ["source_kind"] }, "then": { "required": ["url"], "not": { "required": ["revision"] }, "properties": { "location": { "properties": { "kind": { "const": "repository_code" } }, "required": ["kind"] } } } }
      ]
    },
    "publicationLocation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "publication" },
        "page": { "type": ["string", "integer"] },
        "section": { "type": "string", "minLength": 1 },
        "paragraph": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "anyOf": [{ "required": ["page"] }, { "required": ["paragraph"] }, { "required": ["anchor"] }, { "required": ["table", "field"] }] },
        { "if": { "required": ["table"] }, "then": { "required": ["field"] } }
      ]
    },
    "codeLocation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "commit", "path", "line_start", "line_count"],
      "properties": {
        "kind": { "const": "repository_code" },
        "commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "path": { "type": "string", "minLength": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_count": { "type": "integer", "minimum": 1 }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "outcome", "notes"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date" },
        "outcome": { "enum": ["accepted", "needs_review", "rejected"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "record_id", "evidence_type", "parameter_ids", "assumption", "report_lineage", "review"],
      "properties": {
        "schema_version": { "const": 1 },
        "record_id": { "type": "string", "minLength": 1 },
        "evidence_type": { "const": "synthetic_assumption" },
        "parameter_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^ed\\." } },
        "assumption": { "type": "object", "additionalProperties": false, "required": ["description", "value", "units", "rationale", "sensitivity_needed"], "properties": {
          "description": { "type": "string", "minLength": 1 }, "value": { "not": { "type": "null" } }, "units": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 }, "sensitivity_needed": { "type": "boolean" }
        } },
        "report_lineage": { "$ref": "#/$defs/optionalReportLineage" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "record_id", "evidence_type", "parameter_ids", "gap", "report_lineage", "review"],
      "properties": {
        "schema_version": { "const": 1 },
        "record_id": { "type": "string", "minLength": 1 },
        "evidence_type": { "const": "unresolved_gap" },
        "parameter_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^ed\\." } },
        "gap": { "type": "object", "additionalProperties": false, "required": ["missing_evidence", "owner", "impact", "searches_performed", "next_action"], "properties": {
          "missing_evidence": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 }, "searches_performed": { "type": "array", "items": { "type": "string" } }, "next_action": { "type": "string", "minLength": 1 }
        } },
        "report_lineage": { "$ref": "#/$defs/optionalReportLineage" },
        "review": { "$ref": "#/$defs/review" }
      }
    }
  }
}
